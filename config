[init]
	defaultBranch = main
[submodule]
	recurse = true
[push]
	recurseSubmodules = on-demand
[diff]
	submodule = log
[status]
	submodulesummary = 0
[alias]
    l = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
    a = add
    c = commit --verbose
    cm = commit -m
    s = !git status --short && git diff --stat | tail -n 1
    shp = stash pop
    sh = stash
    yolo = !git add -A && git commit -m \"$(curl -sL https://whatthecommit.com/index.txt)\" && git push -f origin main
